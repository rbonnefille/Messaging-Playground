  <script>

    function deleteItems() {
      // Clear localStorage items 
      // Destroy SunCo widget
      localStorage.clear();
      Smooch.destroy();
    }

    Smooch.init({
      integrationId: myIntegrationId,
      canUserSeeConversationList: true,
    }).then(function () {
      console.log("SunCo widget ready");
      var user = Smooch.getUser();
      console.log(user);
    });

    document.getElementById("btnLogin").addEventListener("click", function () {
      const data = {
        external_id: "m-scott",
        name: "Michael Scott",
        email: "m-scott@example.com"
      };

      fetch("https://romain.ngrok.io/auth", {
        method: "POST",
        // mode: "cors",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      })
        .then((response) => response.json())
        .then((data) => {
          console.log("Success:", data.token);
          Smooch.login('m-scott', data.token);
          Smooch.open();
        })
        .catch((error) => {
          console.error("Error:", error);
          console.log(error);
        });
