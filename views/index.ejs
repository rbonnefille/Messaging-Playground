<img
    src="https://mlst3x584ijx.i.optimole.com/J4U7zT4-jtmOnQok/w:auto/h:auto/q:75/https://acmegeneral.com/wp-content/uploads/2020/09/cropped-ACMELogo_Color_WBKND-01.png" />
<script>

    Smooch.init({
        integrationId: myIntegrationId,
        canUserSeeConversationList: true,
    }).then(function () {
        console.log("SunCo widget ready");
        var user = Smooch.getUser();
        console.log(user);
    });

    document.getElementById("btnLogin").addEventListener("click", function () {
        const data = {
        // external_id: "test12345",
        // email: "email@example.com",
        // name: "Romain",
        externalId: "m-scott"
      };

      fetch("https://romain.ngrok.io/auth", {
        method: "POST",
        // mode: "cors",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      })
        .then((response) => response.json())
        .then((data) => {
          console.log("Success:", data.token);
          Smooch.login('m-scott', data.token);
          Smooch.open();
        })
        .catch((error) => {
          console.error("Error:", error);
          console.log(error);
        });
