<body class="p-3 m-0 border-0 bd-example">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
        crossorigin="anonymous"></script>
    <nav class="d-flex justify-content-center navbar bg-secondary rounded-3" style="--bs-bg-opacity: .3;">
        <div id="navbar" class="p-3 mb-2 h1">Acme corp support</div><br>
    </nav>
    <br>
    <h4 class="h4">Log back in to sync past conversations</h4>
    <div class="grid">
        <form class="row g-3" id=suncoData novalidate>
            <div class="col-md-2">
                <label for="formGroupExampleInput" class="form-label">User externald_id</label>
                <input name="external_id" type="text" class="form-control" placeholder="jane-doe"
                    aria-label="External ID" required>
            </div>
            <div class="col-md-2 p-3 m-0 border-0">
                <label for="formGroupExampleInput" class="form-label">Full Name</label>
                <input name="name" type="text" class="form-control" placeholder="Jane Doe" aria-label="Full name"
                    required>
            </div>
            <div class="col-md-2">
                <label for="formGroupExampleInput" class="form-label">Email Address</label>
                <input name="email" type="text" class="form-control" placeholder="jane-doe@example.com"
                    aria-label="Email address" required>
            </div>
            <div class="col-10">
                <input type="button" class="btn btn-outline-success" value="Submit" onclick="authenticateUser()" />
            </div>
        </form>
    </div>
    <br>
    <div class="grid">
        <h4 class="h4">Sunshine Conversations SDK</h4>
        <div class="p-3 m-0 border-0" role="group" aria-label="Actions">
            <button type="button" class="btn mb-1 btn-primary" onclick="Smooch.open();">Open Widget</button>
            <button type="button" class="btn mb-1 btn-secondary" onclick="Smooch.close();">Close Widget</button>
            <button type="button" class="btn mb-1 btn-warning"
                onclick="Smooch.logout();clearSessionAuth();">Logout
                User</button>
            <button type="button" class="btn mb-1 btn-danger" onclick="deleteItems()">Destroy Widget and clear
                sessionStorage</button>
            <button type="button" class="btn mb-1 btn-danger" onclick="localStorage.clear();">Clear localStorage</button>
        </div>
        <h4 class="h4">Zendesk SDK</h4>
        <div class="p-3 m-0 border-0" role="group" aria-label="Actions">
            <button type="button" class="btn btn-primary" onclick="zE('messenger', 'open');">Open Widget</button>
            <button type="button" class="btn btn-success"
                onclick="zE('messenger', 'loginUser', function (callback) {callback( getSessionAuth().token);
                
                });">Login
                User</button>
            <button type="button" class="btn btn-warning" onclick="zE('messenger', 'logoutUser');">Logout User</button>
            <button type="button" class="btn btn-secondary" onclick="zE('messenger', 'close'); ">Close Widget</button>
        </div>
            <div class="p-3 m-0 border-0" role="group" aria-label="Actions">
                
            <button type="button" class="btn btn-secondary" onclick="zE('messenger:set', 'conversationFields', [{ id: 17826865089553, value: 'test'}]);">Set example metadata</button>
            <code>zE('messenger:set', 'conversationFields', [{ id: 17826865089553, value: 'test'}]);</code>
        </div>
    </div>

    <div class="grid">
        <br>
        <h4 class="h4">Availble routes to access SunCo data</h4>
        <div class="p-3 m-0 border-0 d-inline-flex list-group">
            <a id="getUser" href="#"
                class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId</a>
            <a id="getUserConversations" href="#"
                class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/conversations</a>
            <a id="getUserClients" href="#"
                class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/clients</a>
            <a href="/integrations" class="list-group-item list-group-item-action" aria-current="true">
                List integrations
            </a>
            <a href="/integrations/sbintegrations" class="list-group-item list-group-item-action" aria-current="true">
                List Switchboard integrations
            </a>
        </div>
    </div>
<%- include('./script') %>
</body>