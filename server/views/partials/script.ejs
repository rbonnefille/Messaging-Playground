    const getToken = async (userData) => {
      const response = await fetch(
        'auth',
        {
          method: 'POST',
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(userData)
        }
      );
      if (!response.ok) {
        window.alert(`HTTP error! status: ${response.status}`);
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return await response.json();
    }

    const authenticateUser = async () => {
      const {
        0: {value: external_id}, 
        1: {value: name}, 
        2: {value: email}
      } = document.getElementById("suncoData").elements;
      const data = {
        external_id: external_id || "m-scott",
        name: name || "Michael Scott",
        email: email || "michael-scott@example.com"
      };
      const { token } = await getToken(data);
      setSessionAuth(data.external_id, token);
      setTimeout(() => {
        const { external_id, token } = getSessionAuth();
        Smooch.login(external_id, token);
        changeNavbarText(`Welcome back ${external_id}`);
        Smooch.open();
      }, 1000);
      prefillSuncoRoutes(external_id || "m-scott");
    }

    const prefillSuncoRoutes = (external_id) => {
      const getUserLink = document.getElementById("getUser")
      getUserLink.href = `/users/${external_id}`;
      getUserLink.textContent = `/users/${external_id}`;

      const getUserConversations = document.getElementById("getUserConversations")
      getUserConversations.href = `/users/${external_id}/conversations`;
      getUserConversations.textContent = `/users/${external_id}/conversations`;

      const getUserClients = document.getElementById("getUserClients");
      getUserClients.href = `/users/${external_id}/clients`;
      getUserClients.textContent = `/users/${external_id}/clients`;

      const links = document.querySelectorAll('#getUser, #getUserConversations, #getUserClients');
      links.forEach(link => link.classList.remove("disabled"));
    }

    const changeNavbarText = (text) => {
      document.getElementById("navbar").textContent = text;
    }

    const initializeButton = (iframedocument) => {
      const conversationFooter = iframedocument.getElementsByClassName('conversation-group-footer')[0];
      if (conversationFooter) {
        conversationFooter.innerHTML = '<button onclick=parent.createConversation()>New Conversation</button>';
      }
    }
    function createConversation() {
      if (Smooch.isOpened()) {
        Smooch.createConversation().then((conversation) => {
          Smooch.loadConversation(conversation.id);
        })
      }
    }

    Smooch.on('connected' , () => {
        console.log('Widget is ready for use!');
      });

    Smooch.on('widget:opened', () => {
      const { external_id, token } = getSessionAuth();
      if ((!Smooch.getUser() || Smooch.getConversations().length === 0) && !external_id && !token) {
        Smooch.createConversation();
      } else if (external_id && token) {
        Smooch.login(external_id, token);
        changeNavbarText(`Welcome back ${external_id}`);
      }
    });

    Smooch.on('widget:closed', function () {
      console.log('Widget is closed!');
      // clearSessionAuth();
    });

    zE('messenger:on', 'unreadMessages', function (count) {
      console.log(`You have ${count} unread message(s).`);
      zE('messenger', 'open');
    })

    function detectBrowser() {
      let { mobile, platform } = navigator.userAgentData; 
      document.querySelector("div.form-style h3").innerText = `Mobile: ${mobile} - Platform: ${platform}`;
  }

  </script>
