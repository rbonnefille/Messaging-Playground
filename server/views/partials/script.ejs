    window.onload = function () {
      const { external_id, token } = getSessionAuth();
      if (external_id) {
        prefillSuncoRoutes(external_id);
      }
      detectBrowser();
    };

    const deleteItems = () => {
      clearSessionAuth();
      Smooch.destroy();
    }

    const clearSessionAuth = () => {
      window.sessionStorage.removeItem("<%= sessionStorageKey %>");
      changeNavbarText('Log back in to sync past conversations');
    }

    const setSessionAuth = (external_id, token) => {
      clearSessionAuth();
      window.sessionStorage.setItem(
        "<%= sessionStorageKey %>",
        JSON.stringify({ external_id, token })
      );
    };

    const getSessionAuth = () =>
      JSON.parse(window.sessionStorage.getItem('<%= sessionStorageKey %>')) ?? {};

