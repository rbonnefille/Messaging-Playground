</head>

<body class="p-3 m-0 border-0 bd-example">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
    crossorigin="anonymous"></script>
  <h1>Welcome to our support page</h1>
  <h3>
    Click on the icon on the right buttom of the page to start a conversation!
  </h3>
  <br>

  <div class="grid">
    <form class="row g-3" id=suncoData novalidate>
      <div class="col-md-2">
        <label for="formGroupExampleInput" class="form-label">User externaldId</label>
        <input name="externalid" type="text" class="form-control" placeholder="externalId" aria-label="External ID"
          required>
      </div>
      <div class="col-md-2">
        <label for="formGroupExampleInput" class="form-label">Full Name</label>
        <input name="name" type="text" class="form-control" placeholder="Jane Doe" aria-label="Full name" required>
      </div>
      <div class="col-md-2">
        <label for="formGroupExampleInput" class="form-label">Email Address</label>
        <input name="email" type="text" class="form-control" placeholder="test@test.com" aria-label="Email address"
          required>
      </div>
      <div class="col-10">
        <input type="button" class="btn btn-outline-success" type="submit" value="Submit"
          onclick="authenticateUser()" />
      </div>
    </form>
  </div>
  <br>

  <div class="grid">

    <h3>Below are some other actions for the SunCo Widget</h3>

    <div class="p-3 m-0 border-0 btn-group" role="group" aria-label="Actions">
      <button type="button" class="btn btn-danger" onclick="Smooch.logout()">SunCo Logout</button>
      <button type="button" class="btn btn-warning" onclick="deleteItems()">Clear localStorage</button>
    </div>
  </div>

  <div class="grid">
    <br>
    <h3>Availble routes to access SunCo data</h3>
    <div class="p-3 m-0 border-0 d-inline-flex list-group">
      <a href="#" class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId</a>
      <a href="#" class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/conversations</a>
      <a href="#" class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/clients</a>
      <a href="/integrations/sbintegrations" class="list-group-item list-group-item-action active" aria-current="true">
        List Switchboard integrations
      </a>
    </div>
  </div>

  <script>
    function deleteItems() {
      // Clear localStorage items 
      // Destroy SunCo widget
      // localStorage.clear();
      clearSessionAuth();
      Smooch.destroy();
    }

    const clearSessionAuth = () =>
      window.sessionStorage.removeItem("<%= sessionStorageKey %>");

    const setSessionAuth = (external_id, token) => {
      clearSessionAuth();
      window.sessionStorage.setItem(
        "<%= sessionStorageKey %>",
        JSON.stringify({ external_id, token })
      );
    };

    const getSessionAuth = () =>
      JSON.parse(window.sessionStorage.getItem('<%= sessionStorageKey %>')) || {};

    Smooch.init({
      integrationId: myIntegrationId,
      canUserSeeConversationList: true,
      soundNotificationEnabled: false
      // delegate
    }).then(function () {
      console.log("SunCo widget ready");
      var user = Smooch.getUser();
      console.log(user);
      var iframe = document.getElementById('web-messenger-container');
      iframedocument = iframe.contentDocument || iframe.contentWindow.document;
      iframedocument.addEventListener('click', function (evt) {
        initializeButton(iframedocument)
      }, false);
    });

    function getToken(userData) {
      fetch("auth", {
        method: "POST",
        // mode: "cors",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(userData),
      })
        .then((response) => response.ok ? response.json() : Promise.reject(response))
        .then((data) => {
          console.log("Success:", data.token);
          const token = data.token;
          const external_id = userData.external_id;
          setSessionAuth(external_id, token);
          return data;
        })
        .catch((error) => {
          console.error("Error:", error);
          window.alert(`Error: ${error.statusText}`);
        });
    }

    function authenticateUser() {
      var x = document.getElementById("suncoData");
      var externalid = x.elements[0].value;
      var name = x.elements[1].value;
      var email = x.elements[2].value;
      const data = {
        external_id: externalid,
        name: name,
        email: email
      };
      getToken(data);
      setTimeout(() => {
        Smooch.open();
      }, 1000);
    }

    function initializeButton(iframedocument) {
      var conversationFooter = iframedocument.getElementsByClassName('conversation-group-footer')[0];
      if (conversationFooter) {
        conversationFooter.innerHTML = '<button onclick=parent.createConversation()>New Conversation</button>';
      }
    }
    function createConversation() {
      if (Smooch.isOpened()) {
        Smooch.createConversation().then((conversation) => {
          Smooch.loadConversation(conversation.id);
        })
      }
    }

    Smooch.on('widget:opened', () => {
      const { external_id, token } = getSessionAuth();
      if (!Smooch.getUser() || Smooch.getConversations().length === 0) {
        Smooch.createConversation();
      } else if (external_id && token) {
        Smooch.login(external_id, token);
      }
    });

    // This event triggers when the widget is closed
    Smooch.on('widget:closed', function () {
      console.log('Widget is closed!');
      // clearSessionAuth();
    });

  </script>
</body>

</html>