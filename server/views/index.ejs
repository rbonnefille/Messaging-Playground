<%- include('./partials/head') %>

<body class="p-3 m-0 border-0 bd-example bg-light text-dark">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-kenU1KFdBIe4zVF0s0G1M5b4hcpxyD9F7jL+jjXkk+Q2h455rYXK/7HAuoJl+0I4"
    crossorigin="anonymous"></script>
  <nav class="d-flex justify-content-center navbar bg-secondary text-black rounded-3" style="--bs-bg-opacity: .3;">
    <div class="p-3 mb-2 h1">Acme corp support</div>
  </nav>
  <br>
  <h4>Log back in to sync past conversations</h4>
  <div class="grid">
    <form class="row g-3" id=suncoData novalidate>
      <div class="col-md-2">
        <label for="formGroupExampleInput" class="form-label">User externald_id</label>
        <input name="external_id" type="text" class="form-control" placeholder="jane-doe" aria-label="External ID"
          required>
      </div>
      <div class="col-md-2 p-3 m-0 border-0">
        <label for="formGroupExampleInput" class="form-label">Full Name</label>
        <input name="name" type="text" class="form-control" placeholder="Jane Doe" aria-label="Full name" required>
      </div>
      <div class="col-md-2">
        <label for="formGroupExampleInput" class="form-label">Email Address</label>
        <input name="email" type="text" class="form-control" placeholder="jane-doe@example.com"
          aria-label="Email address" required>
      </div>
      <div class="col-10">
        <input type="button" class="btn btn-outline-success" value="Submit" onclick="authenticateUser()" />
      </div>
    </form>
  </div>
  <br>

  <div class="grid">

    <h4>Sunshine Conversations SDK</h4>

    <div class="p-3 m-0 border-0" role="group" aria-label="Actions">
      <button type="button" class="btn btn-primary" onclick="Smooch.open();">Open Widget</button>
      <button type="button" class="btn btn-secondary" onclick="Smooch.close();">Close Widget</button>
      <button type="button" class="btn btn-warning" onclick="Smooch.logout();clearSessionAuth();">Logout User</button>
      <button type="button" class="btn btn-danger" onclick="deleteItems()">Destroy Widget and clear
        sessionStorage</button>
      <button type="button" class="btn btn-danger" onclick="localStorage.clear();">Clear localStorage</button>
    </div>
    <h4>Zendesk SDK</h4>
    <div class="p-3 m-0 border-0" role="group" aria-label="Actions">
      <button type="button" class="btn btn-primary" onclick="zE('messenger', 'open');">Open Widget</button>
      <button type="button" class="btn btn-success"
        onclick="zE('messenger', 'loginUser', function (callback) {callback( getSessionAuth().token);});">Login
        User</button>
      <button type="button" class="btn btn-warning" onclick="zE('messenger', 'logoutUser');">Logout User</button>
      <button type="button" class="btn btn-secondary" onclick="zE('messenger', 'close'); ">Close Widget</button>
    </div>
  </div>

  <div class="grid">
    <br>
    <h4>Availble routes to access SunCo data</h4>
    <div class="p-3 m-0 border-0 d-inline-flex list-group">
      <a id="getUser" href="#" class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId</a>
      <a id="getUserConversations" href="#"
        class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/conversations</a>
      <a id="getUserClients" href="#"
        class="list-group-item list-group-item-action disabled">/users/:userIdOrExternalId/clients</a>
      <a href="/integrations" class="list-group-item list-group-item-action" aria-current="true">
        List integrations
      </a>
      <a href="/integrations/sbintegrations" class="list-group-item list-group-item-action" aria-current="true">
        List Switchboard integrations
      </a>
    </div>
  </div>

  <script>
    //event on page load
    window.onload = function () {
      const { external_id, token } = getSessionAuth();
      if (external_id) {
        prefillSuncoRoutes(external_id);
      }
    };

    const deleteItems = () => {
      clearSessionAuth();
      Smooch.destroy();
    }

    const clearSessionAuth = () =>
      window.sessionStorage.removeItem("<%= sessionStorageKey %>");

    const setSessionAuth = (external_id, token) => {
      clearSessionAuth();
      window.sessionStorage.setItem(
        "<%= sessionStorageKey %>",
        JSON.stringify({ external_id, token })
      );
    };

    const getSessionAuth = () =>
      JSON.parse(window.sessionStorage.getItem('<%= sessionStorageKey %>')) ?? {};

      // const delegate = {
      //   beforeDisplay(message, data) {
      //     const { source: { type: messageSource }, role, type: messageType, text } = message;
      //     if (messageSource === "zd:agentWorkspace" && role === 'business' && messageType === "text" ) {
      //       //apply same logic for all the language you support
      //       message.text = text.replace("(traducido)", "");
      //       return message
      //     }
      //       return message;
      //   }
      // };

    Smooch.init({
      integrationId: myIntegrationId,
      // delegate,
      canUserSeeConversationList: true,
      soundNotificationEnabled: false
      // delegate
    }).then(function () {
      console.log("SunCo widget ready");
      const user = Smooch.getUser();
      console.log(user);
      const iframe = document.getElementById('web-messenger-container');
      const iframedocument = iframe.contentDocument ?? iframe.contentWindow.document;
      iframedocument.addEventListener('click', function (evt) {
        initializeButton(iframedocument)
      }, false);
    });

    const getToken = async (userData) => {
      const response = await fetch(
        'auth',
        {
          method: 'POST',
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(userData)
        }
      );
      if (!response.ok) {
        window.alert(`HTTP error! status: ${response.status}`);
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      return await response.json();
    }

    const authenticateUser = async () => {
      const x = document.getElementById("suncoData");
      const external_id = x.elements[0].value;
      const name = x.elements[1].value;
      const email = x.elements[2].value;
      const data = {
        external_id: external_id || "m-scott",
        name: name || "Michael Scott",
        email: email || "michael-scott@example.com"
      };
      const userJwt = await getToken(data);
      const token = userJwt.token;
      setSessionAuth(data.external_id, token);
      setTimeout(() => {
        const { external_id, token } = getSessionAuth();
        Smooch.login(external_id, token);
        Smooch.open();
      }, 1500);
      prefillSuncoRoutes(external_id || "m-scott");
    }

    const prefillSuncoRoutes = (external_id) => {
      const getUserLink = document.getElementById("getUser")
      getUserLink.href = `/users/${external_id}`;
      getUserLink.textContent = `/users/${external_id}`;

      const getUserConversations = document.getElementById("getUserConversations")
      getUserConversations.href = `/users/${external_id}/conversations`;
      getUserConversations.textContent = `/users/${external_id}/conversations`;

      const getUserClients = document.getElementById("getUserClients");
      getUserClients.href = `/users/${external_id}/clients`;
      getUserClients.textContent = `/users/${external_id}/clients`;

      const links = document.querySelectorAll('#getUser, #getUserConversations, #getUserClients');
      links.forEach(link => link.classList.remove("disabled"));
    }

    const initializeButton = (iframedocument) => {
      const conversationFooter = iframedocument.getElementsByClassName('conversation-group-footer')[0];
      if (conversationFooter) {
        conversationFooter.innerHTML = '<button onclick=parent.createConversation()>New Conversation</button>';
      }
    }
    function createConversation() {
      if (Smooch.isOpened()) {
        Smooch.createConversation().then((conversation) => {
          Smooch.loadConversation(conversation.id);
        })
      }
    }

    Smooch.on('widget:opened', () => {
      const { external_id, token } = getSessionAuth();
      if ((!Smooch.getUser() ?? Smooch.getConversations().length === 0) && !external_id && !token) {
        Smooch.createConversation();
      } else if (external_id && token) {
        Smooch.login(external_id, token);
      }
    });

    // This event triggers when the widget is closed
    Smooch.on('widget:closed', function () {
      console.log('Widget is closed!');
      // clearSessionAuth();
    });

    zE('messenger:on', 'unreadMessages', function (count) {
      console.log(`You have ${count} unread message(s).`);
      zE('messenger', 'open');
    })

  </script>
  <script id="ze-snippet"
    src="https://static.zdassets.com/ekr/snippet.js?key=<%= messagingWidgetKey %>"> </script>
</body>
<%- include('./partials/footer') %>