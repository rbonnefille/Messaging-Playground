  </script>
</head>
<body>
  <header  class="container" style="width:80%">
    <nav>
      <ul>
        <li><strong>
            <h2>MyCorp support</h2>
          </strong></li>
      </ul>
      <ul>
        <details role="list">
          <summary aria-haspopup="listbox" role="button">Theme</summary>
          <ul role="listbox">
            <li><a href="#" data-theme-switcher="auto">Auto</a></li>
            <li><a href="#" data-theme-switcher="light">Light</a></li>
            <li><a href="#" data-theme-switcher="dark">Dark</a></li>
          </ul>
        </details>
      </ul>
    </nav>
  </header>
  <main class="container" style="width:75%">
    <h4>Log back in to sync past conversations</h4>
    <form id=suncoData novalidate>
      <div class=" grid">
        <label for="formGroupExampleInput">
          User externald_id
          <input class="login" name="external_id" type="text" placeholder="jane-doe" aria-label="External ID" required>
        </label>
        <label for="formGroupExampleInput">
          Full Name
          <input class="login" name="name" type="text" placeholder="Jane Doe" aria-label="Full name" required>
        </label>
      </div>
      <div class="grid">
        <label for="formGroupExampleInput">
          Email Address
          <input class="login" name="email" type="text" placeholder="jane-doe@example.com" aria-label="Email address" required>
        </label>
      </div>
      <div class="grid">
        <input type="button" class="secondary" type="Login" value="Submit" onclick="authenticateUser()" />
      </div>
    </form>
    <h4>Sunshine Conversations SDK</h4>
    <div class="grid">
      <button type="button" onclick="Smooch.open();">Open Widget</button>
      <button type="button" class="secondary" onclick="Smooch.close();">Close Widget</button>
      <button type="button" class="contrast" onclick="Smooch.logout();clearSessionAuth();">Logout
        User</button>
      <button type="button" class="contrast" onclick="deleteItems()">Destroy & 🧽</button>
      <button type="button" class="contrast" onclick="localStorage.clear();">🗑️ localStorage</button>
    </div>
    <h4>Zendesk SDK</h4>
    <div class="grid">
      <button type="button" onclick="zE('messenger', 'open');">Open Widget</button>
      <button type="button" class="secondary"
        onclick="zE('messenger', 'loginUser', function (callback) {callback( getSessionAuth().token);zE('messenger', 'open');});">Login
        User</button>
      <button type="button" class="secondary" onclick="zE('messenger', 'logoutUser');">Logout User</button>
      <button type="button" class="secondary" onclick="zE('messenger', 'close'); ">Close Widget</button>
    </div>
    <h4>Availble routes to access SunCo data</h4>
    <table>
      <tr>
        <td><a id="getUser" href="#" class="disabled">/users/:userIdOrExternalId</a></td>
      </tr>
      <tr>
        <td><a id="getUserConversations" href="#">/users/:userIdOrExternalId/conversations</a>
        </td>
      </tr>
      <tr>
        <td><a id="getUserClients" href="#">/users/:userIdOrExternalId/clients</a></td>
      </tr>
      <tr>
        <td><a href="/integrations" aria-current="true">List integrations</a></td>
      </tr>
      <tr>
        <td><a href="/integrations/sbintegrations" aria-current="true">List Switchboard integrations</a></td>
      </tr>
    </table>
    <script>
      const themeSwitcher = {
        // Config
        _scheme: "auto",
        menuTarget: "details[role='list']",
        buttonsTarget: "a[data-theme-switcher]",
        buttonAttribute: "data-theme-switcher",
        rootAttribute: "data-theme",
        localStorageKey: "picoPreferredColorScheme",

        // Init
        init() {
          this.scheme = this.schemeFromLocalStorage;
          this.initSwitchers();
        },

        // Get color scheme from local storage
        get schemeFromLocalStorage() {
          if (typeof window.localStorage !== "undefined") {
            if (window.localStorage.getItem(this.localStorageKey) !== null) {
              return window.localStorage.getItem(this.localStorageKey);
            }
          }
          return this._scheme;
        },

        // Preferred color scheme
        get preferredColorScheme() {
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        },

        // Init switchers
        initSwitchers() {
          const buttons = document.querySelectorAll(this.buttonsTarget);
          buttons.forEach((button) => {
            button.addEventListener(
              "click",
              (event) => {
                event.preventDefault();
                // Set scheme
                this.scheme = button.getAttribute(this.buttonAttribute);
                // Close dropdown
                document.querySelector(this.menuTarget).removeAttribute("open");
              },
              false
            );
          });
        },

        // Set scheme
        set scheme(scheme) {
          if (scheme == "auto") {
            this.preferredColorScheme == "dark" ? (this._scheme = "dark") : (this._scheme = "light");
          } else if (scheme == "dark" || scheme == "light") {
            this._scheme = scheme;
          }
          this.applyScheme();
          this.schemeToLocalStorage();
        },

        // Get scheme
        get scheme() {
          return this._scheme;
        },

        // Apply scheme
        applyScheme() {
          document.querySelector("html").setAttribute(this.rootAttribute, this.scheme);
        },

        // Store scheme to local storage
        schemeToLocalStorage() {
          if (typeof window.localStorage !== "undefined") {
            window.localStorage.setItem(this.localStorageKey, this.scheme);
          }
        },
      };

      // Init
      themeSwitcher.init();
      //event on page load
      window.onload = function () {
        const { external_id, token } = getSessionAuth();
        if (external_id) {
          prefillSuncoRoutes(external_id);
        }
      };

      function deleteItems() {
        clearSessionAuth();
        Smooch.destroy();
      }

      const clearSessionAuth = () =>
        window.sessionStorage.removeItem("<%= sessionStorageKey %>");

      const setSessionAuth = (external_id, token) => {
        clearSessionAuth();
        window.sessionStorage.setItem(
          "<%= sessionStorageKey %>",
          JSON.stringify({ external_id, token })
        );
      };

      const getSessionAuth = () =>
        JSON.parse(window.sessionStorage.getItem('<%= sessionStorageKey %>')) ?? {};

      Smooch.init({
        integrationId: myIntegrationId,
        businessName: "Corp Me",
        businessIconUrl: "https://media.smooch.io/6062e4fb75a38000d2988959/icons/5df62f4400d00b92ecbd4a705b77abd2.jpg",
        canUserSeeConversationList: true,
        soundNotificationEnabled: false,
        // delegate
      }).then(function () {
        console.log("SunCo widget ready");
        var user = Smooch.getUser();
        console.log(user);
        var iframe = document.getElementById('web-messenger-container');
        iframedocument = iframe.contentDocument ?? iframe.contentWindow.document;
        iframedocument.addEventListener('click', function (evt) {
          initializeButton(iframedocument)
        }, false);
      });

      function getToken(userData) {
        fetch("auth", {
          method: "POST",
          // mode: "cors",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(userData),
        })
          .then((response) => response.ok ? response.json() : Promise.reject(response))
          .then((data) => {
            console.log("Success:", data.token);
            const token = data.token;
            const external_id = userData.external_id;
            setSessionAuth(external_id, token);
            return data;
          })
          .catch((error) => {
            console.error("Error:", error);
            window.alert(`Error: ${error.statusText}`);
          });
      }

      function authenticateUser() {
        var x = document.getElementById("suncoData");
        var external_id = x.elements[0].value;
        var name = x.elements[1].value;
        var email = x.elements[2].value;
        const data = {
          external_id: external_id,
          name: name,
          email: email
        };
        getToken(data);
        setTimeout(() => {
          const { external_id, token } = getSessionAuth();
          Smooch.login(external_id, token);
          Smooch.open();
        }, 1500);
        prefillSuncoRoutes(external_id);
      }

      function prefillSuncoRoutes(external_id) {
        const getUserLink = document.getElementById("getUser")
        getUserLink.href = `/users/${external_id}`;
        getUserLink.textContent = `/users/${external_id}`;

        const getUserConversations = document.getElementById("getUserConversations")
        getUserConversations.href = `/users/${external_id}/conversations`;
        getUserConversations.textContent = `/users/${external_id}/conversations`;

        const getUserClients = document.getElementById("getUserClients");
        getUserClients.href = `/users/${external_id}/clients`;
        getUserClients.textContent = `/users/${external_id}/clients`;

        const links = document.querySelectorAll('#getUser, #getUserConversations, #getUserClients');
        links.forEach(link => link.classList.remove("disabled"));
      }

      function initializeButton(iframedocument) {
        var conversationFooter = iframedocument.getElementsByClassName('conversation-group-footer')[0];
        if (conversationFooter) {
          conversationFooter.innerHTML = '<button onclick=parent.createConversation()>New Conversation</button>';
        }
      }
      function createConversation() {
        if (Smooch.isOpened()) {
          Smooch.createConversation().then((conversation) => {
            Smooch.loadConversation(conversation.id);
          })
        }
      }

      Smooch.on('widget:opened', () => {
        const { external_id, token } = getSessionAuth();
        if ((!Smooch.getUser() ?? Smooch.getConversations().length === 0) && !external_id && !token) {
          Smooch.createConversation();
        } else if (external_id && token) {
          Smooch.login(external_id, token);
        }
      });

      // This event triggers when the widget is closed
      Smooch.on('widget:closed', function () {
        console.log('Widget is closed!');
        // clearSessionAuth();
      });

    </script>
    <script id="ze-snippet"
      src="https://static.zdassets.com/ekr/snippet.js?key=b9b176ae-c123-40a2-b21d-98632fc01aff"> </script>
  </main>
  <footer  class="container" style="width:80%">
    <small>Built with <a href="https://picocss.com">Pico</a> •
  </footer>
</body>
</html>