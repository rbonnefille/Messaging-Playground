# Nuxt binds NUXT_* env vars to runtimeConfig automatically.
# Server-only keys (no "PUBLIC_") are never exposed to the browser;
# NUXT_PUBLIC_* keys are exposed via useRuntimeConfig().public.

# --- Server-only (private) ---
NUXT_APP_ID=
NUXT_POD_BASE_URL=
NUXT_BASE_URL=
NUXT_SWITCHBOARD_ID=
NUXT_SUNCO_JWT=
NUXT_SUNCO_CUSTOM_INTEGRATION_SECRET=
NUXT_NEXT_SWITCHBOARD_INTEGRATION=
NUXT_WEBHOOK_SUNCO=
NUXT_BOT_SWITCHBOARD_INTEGRATION_ID=
NUXT_USERNAME=
NUXT_PASSWORD=
NUXT_BOT_NAME=
NUXT_BOT_AVATAR_URL=
NUXT_DEFAULT_BOT_AVATAR_URL=
NUXT_CAT_API_KEY=
NUXT_CAT_API_URL=
NUXT_CHAT_SHARED_SECRET=
NUXT_ZD_SUBDOMAIN=
NUXT_ZD_APP_GUID=
NUXT_ZD_USERNAME=
NUXT_ZD_PASSWORD=
NUXT_ZD_SSO_SECRET=
NUXT_ZD_SUPPORT_SDK_JWT_SECRET=
NUXT_SUNCO_TWILIO_INTEGRATION_ID=
NUXT_AUTHORISED_ORIGIN=
NUXT_AUTHORISED_ORIGIN_HC=

# --- Public (client-exposed via useRuntimeConfig().public) ---
NUXT_PUBLIC_MESSAGING_KEY=
NUXT_PUBLIC_MESSAGING_EMEA_KEY=
NUXT_PUBLIC_MESSAGING_APAC_KEY=
NUXT_PUBLIC_SUNCO_INTEGRATION_ID=
NUXT_PUBLIC_SUNCO_APP_ID=
NUXT_PUBLIC_ZENDESK_VOICE_LINE_ID=
